{
  "type": "minecraft:notice",
  "title": { "text": "Page link", "color": "white" },
  "body": {
    "type": "minecraft:plain_message",
    "width": 260,
    "contents": { "text": "Pages are numbered from 0. A tab changes to its target page and highlights when that page is open.", "color": "gray" }
  },
  "pause": false,
  "can_close_with_escape": true,
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "kind",
      "label": { "text": "Style" },
      "width": 260,
      "options": [
        { "id": "page", "display": "Go to page", "initial": true },
        { "id": "tab", "display": "Page tab" }
      ]
    },
    {
      "type": "minecraft:number_range",
      "key": "page",
      "label": { "text": "Page" },
      "start": 0,
      "end": 8,
      "step": 1,
      "initial": 0,
      "width": 260
    }
  ],
  "action": {
    "label": { "text": "Save", "color": "green" },
    "width": 260,
    "action": {
      "type": "dynamic/run_command",
      "template": "function guikit:editor/ui/page {page:$(page),kind:\"$(kind)\"}"
    }
  }
}
